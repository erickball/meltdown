# The water property data is generated by the Python scripts in scripts/, which
# write LF. Without this, autocrlf checks them out as CRLF and re-running the
# generators shows a whole-file diff that is purely line endings.
scripts/saturation_dome_iapws.json text eol=lf
scripts/uv_grid_data_v5.json text eol=lf
scripts/uv_grid_data_v13.json text eol=lf
scripts/uv_grid_data_v13_filtered.json text eol=lf
public/saturation_dome_iapws.json text eol=lf
public/uv_grid_data_v13_filtered.json text eol=lf
*.py text eol=lf
